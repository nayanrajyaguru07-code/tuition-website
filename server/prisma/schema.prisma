// 1. Define the database connection
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================
// 1. HOSTEL (USER) MODEL
// ==========================
model Hostel {
  id          Int       @id @default(autoincrement())
  hostelName  String
  email       String    @unique
  password    String
  fee         Float?    @default(0) // Base fee set by the hostel
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relation: One Hostel manages Many Students
  students    Student[]

  // Relation: One Hostel has many Fee Collections
  feeCollections FeeCollection[]

  // Relation: One Hostel has many Employees
  employees Employee[]

  // Relations: expense and salary
  salaryPayments SalaryPayment[]
  expenses       Expense[]
  rooms          Room[]
}

// ==========================
// 2. STUDENT MODEL
// ==========================
model Student {
  id              Int      @id @default(autoincrement())

  // --- Personal Details ---
  fullName        String
  fatherName      String
  dob             DateTime
  age             Int
  gender          String
  nationality     String
  category        String?  // Optional (e.g., General / OBC / SC / ST)

  // --- Contact Details ---
  studentMobileNo    String
  email              String   @unique
  fatherPhoneNo      String
  emergencyContactNo String
  permanentAddress   String

  // --- Academic Details ---
  schoolCollegeName  String
  courseClassYear    String   // e.g., "B.Tech 3rd Year"

  // --- Hostel Details ---
  dateOfJoining   DateTime @default(now())
  
  // Foreign Key (Link to Hostel)
  hostelId        Int
  hostel          Hostel   @relation(fields: [hostelId], references: [id])

  // --- Room Allocation ---
  roomId          Int?
  room            Room?    @relation(fields: [roomId], references: [id])

  // --- Documents (URLs) ---
  passportPhotoUrl   String?  // URL to stored image
  idProofUrl         String?  // URL (Aadhaar / Passport / Voter ID)
  admissionProofUrl  String?  // URL (Fee Receipt)
  parentIdProofUrl   String?  // URL (Parent's ID)

  // --- Timestamps ---
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relation: One Student has many Payment Records
  feeCollections FeeCollection[]
}

// ==========================
// ROOM MODEL
// ==========================
model Room {
  id          Int      @id @default(autoincrement())
  roomNumber  String
  type        String   // e.g., "Single", "Double", "Triple"
  capacity    Int      @default(1)
  price       Float?   @default(0)

  // Relation to Hostel
  hostelId    Int
  hostel      Hostel   @relation(fields: [hostelId], references: [id])

  // Relation to Students
  students    Student[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================
// 3. FEE COLLECTION MODEL
// ==========================
model FeeCollection {
  id              Int      @id @default(autoincrement())
  
  // Payment Details
  amount          Float
  paymentDate     DateTime @default(now())
  paymentMethod   String   // e.g., "Cash", "UPI", "Bank Transfer", "Cheque"
  transactionId   String?  // Optional: For UPI/Bank Ref No.
  remarks         String?  // Optional: e.g., "January Month Fee" or "Late Fine included"
  
  // Relationships
  studentId       Int
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  hostelId        Int
  hostel          Hostel   @relation(fields: [hostelId], references: [id])

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================
// 4. EMPLOYEE MODEL
// ==========================
model Employee {
  id            Int      @id @default(autoincrement())
  
  // --- Personal Details ---
  name          String
  email         String?  // Optional, as some staff (e.g. cleaners) might not have email
  phone         String
  address       String?
  gender        String?  
  
  // --- Job Details ---
  role          String   // e.g., "Warden", "Security Guard", "Cook", "Sweeper"
  salary        Float?
  dateOfJoining DateTime @default(now())
  
  // --- Media ---
  photoUrl      String?
  idProofUrl    String?

  // --- Relation ---
  hostelId      Int
  hostel        Hostel   @relation(fields: [hostelId], references: [id])

  // --- Timestamps ---
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relation: One Employee has many Salary Records
  salaryPayments SalaryPayment[]
}

// ==========================
// 5. SALARY PAYMENT MODEL
// ==========================
model SalaryPayment {
  id              Int      @id @default(autoincrement())
  
  amount          Float
  salaryMonth     String   // e.g., "January 2026"
  paymentDate     DateTime @default(now())
  paymentMethod   String   // e.g., "Cash", "Bank Transfer"
  remarks         String?  // Optional notes

  // Relations
  employeeId      Int
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  hostelId        Int
  hostel          Hostel   @relation(fields: [hostelId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================
// 6. GENERAL EXPENSE MODEL
// ==========================
model Expense {
  id              Int      @id @default(autoincrement())
  
  title           String   // e.g., "Electricity Bill", "Vegetables", "Plumber"
  amount          Float
  expenseDate     DateTime @default(now())
  category        String?  // e.g., "Utilities", "Food", "Maintenance"
  paymentMethod   String?
  description     String?
  billUrl         String?  // Optional: Upload photo of receipt/bill

  // Relation
  hostelId        Int
  hostel          Hostel   @relation(fields: [hostelId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

